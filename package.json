{
  "name": "real-time-monitor",
  "version": "1.0.0",
  "description": "Real-Time System Monitor Dashboard using Electron and React",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "npm run build-react && electron .",
    "dev": "concurrently \"npm run dev-react\" \"wait-on http://localhost:5173 && electron .\"",
    "dev-react": "cd src/frontend && vite",
    "build-react": "cd src/frontend && vite build",
    "build-backend": "cmake --build build",
    "build-app": "npm run build-backend && npm run build-react",
    "package-mac": "electron-packager . RealTimeMonitor --platform=darwin --arch=x64 --out=dist --overwrite",
    "package-linux": "electron-packager . RealTimeMonitor --platform=linux --arch=x64 --out=dist --overwrite",
    "package-win": "npm run build-app && electron-packager . RealTimeMonitor --platform=win32 --arch=x64 --out=dist --overwrite",
    "package-all": "electron-packager . RealTimeMonitor --platform=darwin,linux,win32 --arch=x64 --out=dist --overwrite"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^8.0.0",
    "electron": "^37.1.0",
    "electron-packager": "^17.1.2",
    "vite": "^7.0.0",
    "wait-on": "^7.0.0"
  }
}
